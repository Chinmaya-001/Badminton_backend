# Server Configuration
PORT=8080
NODE_ENV=production

# Supabase PostgreSQL Database Credentials
DB_HOST=your-supabase-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# Optional: DATABASE_URL can be used instead of individual DB_* variables
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Supabase Storage & Client API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=player-photo

# JWT Authentication
JWT_SECRET=your-jwt-secret-key
